  "firestore": {
    "/purchase_requisitions/{prId}": {
      "schema": { "$ref": "#/entities/PurchaseRequisition" },
      "description": "คอลเลกชันใบขอซื้อ/ขอจ้าง (PR)"
    },
    "/purchase_orders/{poId}": {
      "schema": { "$ref": "#/entities/PurchaseOrder" },
      "description": "คอลเลกชันใบสั่งซื้อ/สั่งจ้าง (PO)"
    },
    "/goods_receipts/{grId}": {
      "schema": { "$ref": "#/entities/GoodsReceipt" },
      "description": "คอลเลกชันใบตรวจรับพัสดุ (GR)"
    },
    "/vendors/{vendorId}": {
      "schema": { "$ref": "#/entities/Vendor" },
      "description": "คอลเลกชันข้อมูลผู้ขายและคู่ค้า"
    },
    "/payroll_periods/{periodId}": {
      "schema": { "$ref": "#/entities/PayrollPeriod" },
      "description": "คอลเลกชันงวดการคำนวณเงินเดือน"
    },
    "/payroll_records/{recordId}": {
      "schema": { "$ref": "#/entities/PayrollRecord" },
      "description": "คอลเลกชันสลิปและข้อมูลคำนวณเงินเดือนรายบุคคล"
    },
    "/system_settings/{settingId}": {
      "schema": { "$ref": "#/entities/SystemSettings" },
      "description": "คอลเลกชันการตั้งค่าระบบส่วนกลาง (general)"
    },
    "/employees/{employeeId}": {
      "schema": { "$ref": "#/entities/Employee" },
      "description": "คอลเลกชันรายชื่อพนักงาน"
    },
    "/equipment/{equipmentId}": {
      "schema": { "$ref": "#/entities/Equipment" },
      "description": "คอลเลกชันอุปกรณ์เกษตร"
    },
    "/transactions/{transactionId}": {
      "schema": { "$ref": "#/entities/Transaction" },
      "description": "คอลเลกชันประวัติเบิกคืน"
    },
    "/attendance/{attendanceId}": {
      "schema": { "$ref": "#/entities/Attendance" },
      "description": "คอลเลกชันลงเวลาเข้างาน"
    },
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "คอลเลกชันผู้ใช้งานและสิทธิ์ระบบ"
    },
    "/categories/{categoryId}": {
      "schema": { "$ref": "#/entities/Category" },
      "description": "คอลเลกชันหมวดหมู่อุปกรณ์"
    },
    "/departments/{departmentId}": {
      "schema": { "$ref": "#/entities/Department" },
      "description": "คอลเลกชันแผนกและฝ่ายงาน (DEP-xxx)"
    },
    "/positions/{positionId}": {
      "schema": { "$ref": "#/entities/Position" },
      "description": "คอลเลกชันตำแหน่งงานและสายงาน (POS-xxx)"
    },
    "/locations/{locationId}": {
      "schema": { "$ref": "#/entities/Location" },
      "description": "คอลเลกชันสถานที่จัดเก็บอุปกรณ์ (LOC-xxx)"
    },
    "/audit_logs/{auditLogId}": {
      "schema": { "$ref": "#/entities/AuditLog" },
      "description": "คอลเลกชันประวัติการเพิ่ม แก้ไข ลบ ข้อมูลในระบบ"
    }
  }
}
