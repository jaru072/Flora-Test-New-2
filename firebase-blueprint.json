{
  "entities": {
    "Employee": {
      "title": "Employee",
      "description": "รายชื่อบุคลากรและพนักงาน",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "role": { "type": "string" },
        "department": { "type": "string" },
        "phone": { "type": "string" }
      },
      "required": ["id", "name", "role", "department"]
    },
    "Equipment": {
      "title": "Equipment",
      "description": "คลังอุปกรณ์เครื่องมือเกษตรกรรม",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "code": { "type": "string" },
        "name": { "type": "string" },
        "category": { "type": "string" },
        "status": { "type": "string" },
        "total": { "type": "number" },
        "available": { "type": "number" }
      },
      "required": ["id", "code", "name", "category"]
    },
    "Transaction": {
      "title": "Transaction",
      "description": "ประวัติการเบิก-คืน-ยืมอุปกรณ์",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "type": { "type": "string" },
        "employeeName": { "type": "string" },
        "equipmentName": { "type": "string" },
        "amount": { "type": "number" },
        "timestamp": { "type": "string" }
      }
    },
    "Attendance": {
      "title": "Attendance",
      "description": "ประวัติการลงเวลาเข้างาน/เลิกงาน/แจ้งลา พร้อมพิกัด GPS",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "employeeId": { "type": "string" },
        "employeeName": { "type": "string" },
        "employeeCode": { "type": "string" },
        "department": { "type": "string" },
        "role": { "type": "string" },
        "status": { "type": "string" },
        "time": { "type": "string" },
        "date": { "type": "string" },
        "dateKey": { "type": "string" },
        "note": { "type": "string" },
        "timestamp": { "type": "string" },
        "source": { "type": "string" },
        "latitude": { "type": "number" },
        "longitude": { "type": "number" },
        "accuracy": { "type": "number" },
        "locationAddress": { "type": "string" }
      }
    },
    "User": {
      "title": "User",
      "description": "ข้อมูลผู้ใช้งานระบบและบทบาท (Admin, Manager, Worker)",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "role": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["uid", "email", "role"]
    },
    "Category": {
      "title": "Category",
      "description": "หมวดหมู่อุปกรณ์การเกษตร พร้อมรหัสมาตรฐาน (CAT-xxx)",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "code": { "type": "string" },
        "name": { "type": "string" },
        "prefix": { "type": "string" },
        "icon": { "type": "string" },
        "label": { "type": "string" }
      },
      "required": ["id", "code", "name"]
    },
    "Department": {
      "title": "Department",
      "description": "แผนกและฝ่ายงาน พร้อมรหัสมาตรฐาน (DEP-xxx)",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "code": { "type": "string" },
        "name": { "type": "string" }
      },
      "required": ["id", "code", "name"]
    },
    "Location": {
      "title": "Location",
      "description": "สถานที่จัดเก็บอุปกรณ์ พร้อมรหัสมาตรฐาน (LOC-xxx)",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "code": { "type": "string" },
        "name": { "type": "string" }
      },
      "required": ["id", "code", "name"]
    },
    "Position": {
      "title": "Position",
      "description": "ตำแหน่งงานและสายงานในองค์กร พร้อมรหัสมาตรฐาน (POS-xxx)",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "code": { "type": "string" },
        "name": { "type": "string" },
        "group": { "type": "string" },
        "order": { "type": "number" }
      },
      "required": ["id", "code", "name"]
    },
    "AuditLog": {
      "title": "AuditLog",
      "description": "ประวัติการเพิ่ม แก้ไข ลบ บุคลากร อุปกรณ์ หมวดหมู่ และแผนก",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "timestamp": { "type": "string" },
        "rawTimestamp": { "type": "number" },
        "userEmail": { "type": "string" },
        "userName": { "type": "string" },
        "module": { "type": "string" },
        "action": { "type": "string" },
        "details": { "type": "string" },
        "recordId": { "type": "string" }
      },
      "required": ["id", "timestamp", "userEmail", "module", "action", "details"]
    },
    "SystemSettings": {
      "title": "SystemSettings",
      "description": "การตั้งค่าระบบส่วนกลาง เช่น โลโก้องค์กร (globalLogo)",
      "type": "object",
      "properties": {
        "globalLogo": { "type": "string" },
        "updatedAt": { "type": "string" },
        "updatedBy": { "type": "string" }
      }
    },
    "PayrollPeriod": {
      "title": "PayrollPeriod",
      "description": "รอบงวดการจ่ายเงินเดือนและสรุปภาพรวม",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "month": { "type": "number" },
        "year": { "type": "number" },
        "startDate": { "type": "string" },
        "endDate": { "type": "string" },
        "payDate": { "type": "string" },
        "status": { "type": "string", "enum": ["draft", "processing", "approved", "paid"] },
        "totalEmployees": { "type": "number" },
        "totalBaseSalary": { "type": "number" },
        "totalOt": { "type": "number" },
        "totalAllowances": { "type": "number" },
        "totalDeductions": { "type": "number" },
        "totalSocialSecurity": { "type": "number" },
        "totalTax": { "type": "number" },
        "totalNetPay": { "type": "number" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" },
        "createdBy": { "type": "string" }
      },
      "required": ["id", "title", "month", "year", "status"]
    },
    "PayrollRecord": {
      "title": "PayrollRecord",
      "description": "ใบสรุปและสลิปเงินเดือนรายบุคคลสำหรับแต่ละงวด",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "periodId": { "type": "string" },
        "employeeId": { "type": "string" },
        "employeeCode": { "type": "string" },
        "employeeName": { "type": "string" },
        "department": { "type": "string" },
        "position": { "type": "string" },
        "bankName": { "type": "string" },
        "bankAccount": { "type": "string" },
        "baseSalary": { "type": "number" },
        "dailyRate": { "type": "number" },
        "otHours": { "type": "number" },
        "otRate": { "type": "number" },
        "otAmount": { "type": "number" },
        "diligenceAllowance": { "type": "number" },
        "positionAllowance": { "type": "number" },
        "bonus": { "type": "number" },
        "otherEarnings": { "type": "number" },
        "totalEarnings": { "type": "number" },
        "lateMinutes": { "type": "number" },
        "lateDeduction": { "type": "number" },
        "absenceDays": { "type": "number" },
        "absenceDeduction": { "type": "number" },
        "leaveDeduction": { "type": "number" },
        "socialSecurity": { "type": "number" },
        "tax": { "type": "number" },
        "otherDeductions": { "type": "number" },
        "totalDeductions": { "type": "number" },
        "netPay": { "type": "number" },
        "status": { "type": "string" },
        "remarks": { "type": "string" },
        "attendanceSummary": { "type": "object" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "periodId", "employeeId", "employeeName", "netPay"]
    },
    "PurchaseRequisition": {
      "title": "PurchaseRequisition",
      "description": "ใบขอซื้อ/ขอจ้าง (PR) สำหรับแต่ละแผนก",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "prNumber": { "type": "string" },
        "department": { "type": "string" },
        "requesterName": { "type": "string" },
        "requesterEmail": { "type": "string" },
        "objective": { "type": "string" },
        "status": { "type": "string", "enum": ["draft", "pending", "approved", "rejected", "po_created"] },
        "priority": { "type": "string", "enum": ["normal", "urgent", "critical"] },
        "items": { "type": "array" },
        "totalAmount": { "type": "number" },
        "approvedBy": { "type": "string" },
        "approvedDate": { "type": "string" },
        "rejectionReason": { "type": "string" },
        "createdDate": { "type": "string" },
        "createdTime": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "prNumber", "department", "requesterName", "status", "totalAmount"]
    },
    "PurchaseOrder": {
      "title": "PurchaseOrder",
      "description": "ใบสั่งซื้อ/สั่งจ้าง (PO) อย่างเป็นทางการ",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "poNumber": { "type": "string" },
        "prId": { "type": "string" },
        "prNumber": { "type": "string" },
        "vendorId": { "type": "string" },
        "vendorName": { "type": "string" },
        "vendorTaxId": { "type": "string" },
        "vendorPhone": { "type": "string" },
        "vendorAddress": { "type": "string" },
        "department": { "type": "string" },
        "status": { "type": "string", "enum": ["issued", "receiving", "completed", "cancelled"] },
        "paymentTerms": { "type": "string" },
        "expectedDeliveryDate": { "type": "string" },
        "items": { "type": "array" },
        "subtotal": { "type": "number" },
        "vatAmount": { "type": "number" },
        "totalAmount": { "type": "number" },
        "notes": { "type": "string" },
        "createdDate": { "type": "string" },
        "createdTime": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "poNumber", "vendorName", "status", "totalAmount"]
    },
    "GoodsReceipt": {
      "title": "GoodsReceipt",
      "description": "ใบตรวจรับพัสดุและงานจ้าง (GR) ตรวจสอบความถูกต้อง 3 ด้าน",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "grNumber": { "type": "string" },
        "poId": { "type": "string" },
        "poNumber": { "type": "string" },
        "receiverName": { "type": "string" },
        "receiverEmail": { "type": "string" },
        "receiptDate": { "type": "string" },
        "receiptTime": { "type": "string" },
        "invoiceNumber": { "type": "string" },
        "deliveryNoteNumber": { "type": "string" },
        "inspectionStatus": { "type": "string", "enum": ["pass", "partial", "rejected"] },
        "itemsReceived": { "type": "array" },
        "attachedPhotos": { "type": "array" },
        "inspectionNotes": { "type": "string" },
        "createdDate": { "type": "string" },
        "createdTime": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "grNumber", "poNumber", "receiverName", "inspectionStatus"]
    },
    "Vendor": {
      "title": "Vendor",
      "description": "รายชื่อผู้ขาย คู่ค้า และผู้รับจ้าง",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "code": { "type": "string" },
        "name": { "type": "string" },
        "category": { "type": "string" },
        "taxId": { "type": "string" },
        "phone": { "type": "string" },
        "email": { "type": "string" },
        "address": { "type": "string" },
        "bankAccount": { "type": "string" },
        "rating": { "type": "number" },
        "status": { "type": "string", "enum": ["active", "suspended"] },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "code", "name"]
    }
